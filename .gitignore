# Vendored Harmony source tree. We develop against it locally but do not
# commit it; the mobile client is a separate program.
harmony/

# Hand-off notes for the upstream Harmony maintainer: changes this client needs
# from the server/web client. Kept local, not part of this project.
UPSTREAM_CHANGES.md

# Dependencies and build output.
node_modules/
dist/

# Local build toolchain (JDK/SDK downloaded to verify the APK build).
.toolchain/

# Logs and local environment overrides.
*.log
.env
.env.*

# Editor / OS cruft.
.DS_Store
.idea/
.vscode/

# The android/ and ios/ native projects carry their own .gitignore files
# generated by Capacitor; generated assets and build output are handled there.
